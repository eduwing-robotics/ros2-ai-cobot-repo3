# 설정 — .env 는 기계마다 다르다. 형식은 .env.example 을 본다
.env

# 생성물 — node scripts/build/config.mjs 가 .env 에서 만든다
# 경로는 D23(`shared/model/` → `Shared/data/`) 을 따라간다. 어긋나면 생성물이 커밋된다 (D14).
Shared/data/config/marker-offset.json
Shared/data/config/gripper-mount.json
Shared/data/config/tb-host.json

# 겹침 감시의 최신 한 줄 (scripts/map/watch-calib.py · 1초마다 덮어쓴다).
# **`global-cam.json` 과 달리 측정 결론이 아니라 지금 상태다** — 기계마다 다르고,
# 커밋하면 남의 기계 값이 남아 나이만 늙는다. 커밋되면 오히려 판정을 망친다.
Shared/data/config/global-cam-drift.json
# 터틀봇 자리 — 브리지 안 상주(`anchors.start_tracker(name="amr")`)가 **1초마다 덮어쓴다.**
# `scene-anchors.json`(가만히 있는 소품 · 커밋한다)과 달리 이건 **달리는 로봇의 지금 자리**라
# 커밋하면 늙은 자리가 레포에 남는다 — 읽는 쪽이 나이로 fail-closed 하는 값이므로
# 옛 값이 섞이는 것이 없는 것보다 나쁘다 (2026-08-28)
Shared/data/config/amr-pose.json
# 저쪽 감시기가 훑어서 찾은 폰 주소 — **맥에는 없는 게 정상**이다 (deploy/fr5-ubuntu.sh:18)
Shared/data/config/global-cam-host.json

# 폰이 dev 서버로 보낸 진단 로그 (AR/vite.config.js §diagSink)
# 측정 원본이지 SSOT 가 아니다 — 결론만 docs/evidence/ 로 옮긴다
.diag/

# 영상 원본 — 리포가 붓는다. `scripts/dev/shot.sh --mov` 이 gif + 대표 프레임으로 구워
# 그 산출물만 커밋한다 (gif 상한 2MB). 원본은 각자 로컬에 둔다
docs/evidence/**/*.mov
docs/evidence/**/*.mp4
docs/evidence/**/*.webm

# 시뮬 산출 — 장면 MJCF·배치 결과. **전부 생성물이다** (D14).
# 장면은 `node Sim/scene/build-scene.mjs` 가 config.yaml·URDF 에서 다시 굽고,
# 배치는 같은 seed 면 같은 파일이 다시 나온다(재현성 V4). 커밋하면 설정이 바뀐 뒤에도
# 옛 장면이 남아 **어느 값으로 잰 숫자인지** 못 가린다 — 계약 §데이터 `sceneBuiltFrom` 과 같은 이유.
Sim/out/

# macOS
.DS_Store

# Vercel
.vercel/

# 생성물 — 스크립트로 다시 만든다
#   python3 scripts/assets/make-marker-test-images.py
AR/test/marker-images/

# 파이썬
__pycache__/
*.pyc
.pytest_cache/

# 외부 툴이 cwd 에 남기는 작업 상태. **경로는 그 툴이 정한다 — 옮길 수 없다.**
# 우리 SSOT 가 아니고 세션이 끝나면 안에 적힌 참조가 죽는다 (2026-08-07 확인).
.img2threejs/
node_modules/
*/dist/
AR/dist/
Fr5Dashboard/dist/

# 캘리브레이션 원본 사진·실측 서식 (scripts/dev/capture-cam.py)
# 측정 원본이지 SSOT 가 아니다 — 결론은 Shared/data/config/global-cam.json 으로 간다
# ⚠ `calib-shots/` 가 아니라 `calib-shots/*` 다 — **git 은 제외된 폴더 안의 파일을
# `!` 로 되살리지 못한다** (2026-08-08 에 그렇게 써 보고 안 먹는 걸 확인했다).
calib-shots/*
# **배치도는 예외다.** 사진은 원본이지만 `tag-layout.json` 은 거기서 **유도한 측정값**이다 —
# 태그 4장의 상대 위치를 잰 것이라 다시 만들려면 랩에 가야 한다. `global-cam.json` 의
# 외부 파라미터가 이 파일을 입력으로 쓰므로, 없으면 그 값을 다시 못 푼다.
!calib-shots/tag-layout.json

# OpenCode 정찰 스크래치 — SSOT 가 아니다
scratchpad/

# 합성 고정물 — python3 scripts/map/make-fixture.py 로 다시 만든다
AR/test/cam-fixture/

# 가우시안 스플랫 — 작업물이 수백 MB 다 (scripts/map/splat-build.sh)
.splat-work/
scripts/map/splat-view/lib/
scripts/map/splat-view/*.ply
scripts/map/splat-view/start-pose.json

# 시네마틱 렌더의 중간 산출물 — **다시 구우면 그대로 나온다**(결정론 · D107).
# 프레임 2,030장이 1.0GB 다. 남기는 것은 최종 mp4 와 사람이 보는 시트뿐.
docs/evidence/*/cine/*/
docs/evidence/*/cine/[a-z]*.mp4
!docs/evidence/*/cine/demo.mp4
docs/evidence/*/cine-probe/frames/
docs/evidence/*/cine-probe/probe.mp4
docs/evidence/*/cine-probe/repeat-*.png
# 개별 접점 이미지는 3×3 시트(contact.png)와 중복이다
docs/evidence/*/cine/contact-*.png
docs/evidence/*/cine/concat.txt

# 브리지·게이트가 만드는 산출물 — 레포에 안 산다 (2026-08-31)
Shared/data/config/amr-frame.json
scripts/check/.frames-chain.json
