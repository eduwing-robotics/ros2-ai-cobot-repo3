# FR5Web 설정 — **여기가 사람이 고치는 유일한 곳이다.**
#
# 쓰는 법
#   cp .env.example .env      # .env 는 gitignore 대상 (기계마다 다른 값)
#   <값 수정>
#   node scripts/build/config.mjs     # web/config/*.json 을 생성한다
#
# 왜 JSON 을 생성하나
#   브라우저는 환경변수를 읽을 수 없다. `process.env` 가 없다.
#   그래서 이 파일을 **빌드 시점에 JSON 으로 굽고**, 브라우저는 그 JSON 을 fetch 한다.
#   즉 이 파일이 SSOT 이고 `web/config/*.json` 은 산출물이다 — 직접 고치지 않는다.
#
# 셸 환경변수가 이 파일을 이긴다:
#   FR5_MARKER_BARCODE=5 node scripts/build/config.mjs

# ─────────── 마커 (web/config/marker-offset.json) ───────────

# 인쇄물의 **검은 사각형 한 변**. 자로 재서 넣는다 — 프린터가 축소한다.
# 시트 목표는 A4=170 · A3=240 이지만 2026-07-30 실측은 143 이었다 (배율 84%).
# 이 값이 틀리면 로봇 크기가 틀리고 정합 오차 측정이 무의미해진다. 범위 40~400.
FR5_MARKER_MM=45

# 3x3_HAMMING63 마커 번호. **인쇄한 시트와 반드시 같아야 한다** — 다르면 아무것도 안 뜬다.
# 원본이 있는 것: 2(예비) · 3(검출 테스트용) · 5(정본). 범위 0~7.
FR5_MARKER_BARCODE=5

# 마커 원점 → 로봇 베이스 원점 (mm). 실물 옆 시연에서 자로 한 번 잰다.
# 로봇 없이 하는 데모에서는 0,0,0 이어도 된다.
FR5_MARKER_TO_ROBOT_MM=0,0,0

# 위 값들이 **인쇄물 실측값인가.** false 면 화면에 경고가 뜬다.
FR5_MARKER_VERIFIED=true

# ─────────── 그리퍼 (web/config/gripper-mount.json) ───────────
# 유도 과정은 docs/evidence/2026-07-30-gripper-mount.md

# 붙일 링크. URDF 에 그리퍼가 없어 코드로 매단다.
FR5_GRIPPER_PARENT_LINK=wrist3_link

# 그리퍼 STL 은 **밀리미터**, 팔 URDF 는 **미터**다. 이 값을 빼면 1000배로 뜬다.
FR5_GRIPPER_MESH_SCALE=0.001

# 장착 위치(mm)·회전(도). 실측으로 확정 — 플랜지 간격 0.00mm.
# 회전 X 는 +90 이다. -90 은 방향이 반대라 팔 안쪽에 파묻힌다.
FR5_GRIPPER_POSITION_MM=0,-325.64,170.98
FR5_GRIPPER_ROTATION_DEG=90,0,0

FR5_GRIPPER_VERIFIED=true

# 몸통 끝 → 핑거 끝 (mm). **여기 하나만 고치면 따라오는 것들** —
#   gripper-mount.json 의 toolLengthMm(=110+이 값) · depthCam.tcpYMm · depthCam.lensHeightMm.
# 핑거팁은 대환 공식 STEP 에도 없는 고객 부품이라 갈아 끼우는 것이 정상이다 (STACK.md §그리퍼).
# ⚠ 이 값을 고치면 **핑거 STL·펜던트 툴 Z·작업영역 실측**도 같이 가야 한다 —
#   순서와 검증은 docs/ref/runbook/FINGER-SWAP.md 가 정본이다.
FR5_GRIPPER_FINGER_MM=25

# ─────────── 손목 뎁스카메라 D435 (그리퍼에 얹힌다) ───────────
# 기하의 정본은 docs/ref/arch/DEPTH-CAM.md. 여기 넷은 3D 에 세울 때 쓰는 값이고,
# 카메라 크기(90x25x25)·브래킷 판 폭(79)처럼 안 바뀌는 값은 config.mjs 에 상수로 있다.

# 구조 — 그리퍼의 **벽을 보는 면**(법선 +Z · X 35.6 × Y 87.5)에 체결부가 붙고,
# 거기서 +Z 로 뻗은 브래킷에 카메라를 꽂아 **작업대를 내려다보게** 한다.
# 옆면(X)으로 뻗는 게 아니다 — 2026-08-10 에 관절값을 읽어 확정했다.

# 뻗는 쪽. +1 = +Z. 처음 -1 로 잡았다가 실렌더에서 브래킷이 팔 안쪽을 향해 뒤집었다.
FR5_DEPTHCAM_OUT_SIGN=1

# 툴 축 → 렌즈 중앙, 뻗는 방향 거리 (2026-08-05 실측)
FR5_DEPTHCAM_LENS_OFFSET_MM=82

# ⚠ 「핑거 밑면(TCP) → 렌즈 높이」는 **더 이상 여기 없다** (2026-08-11). 렌즈는 몸통에 붙어
# 안 움직이고 TCP 만 핑거를 따라 내려가므로, 그 값은 실측 상수가 아니라 핑거 길이의 함수다.
# config.mjs 가 (110 + FR5_GRIPPER_FINGER_MM − 55) 로 굽는다 — 25mm 핑거에서 80 으로 같다.

# 체결면 → 브래킷 끝 (2026-08-10 실측)
FR5_DEPTHCAM_BRACKET_REACH_MM=85

# 그리퍼에 닿는 체결 단면 X × Y, 그리고 면 최상단(Y=-72)에서 접촉면 상단까지의 거리.
# **셋이 서로를 검산한다** — -72+25 = -47, -47+30 = -17 이고 이는 렌즈면 높이
# (63.02-80 = -16.98)와 같다. 즉 접촉부 아래 끝과 렌즈면이 같은 평면이다.
FR5_DEPTHCAM_CLEAT_W_MM=27
FR5_DEPTHCAM_CLEAT_H_MM=30
FR5_DEPTHCAM_CLEAT_DROP_MM=25

# 카메라가 판 끝에서 **선꽂는 쪽으로** 나온 길이 (2026-08-10 실측).
# 양수 = +X 쪽. **카메라는 판 한가운데가 아니다** — 15mm 는 카메라·판의 폭 차이(11mm)보다
# 커서, 카메라가 한쪽 끝을 넘어 걸치고 반대쪽은 판이 4mm 더 길다.
FR5_DEPTHCAM_CAM_JUT_MM=15

# 옆면 부호가 확정되면 true. false 면 화면에 "실측값이 아니다" 경고가 뜬다.
FR5_DEPTHCAM_VERIFIED=false

# ─────────── Supabase — 보류 (D81 · 2026-08-06) ───────────
# 공유층은 **랩 안 상주 기계의 SQLite** 로 갔다. 아래 값들은 지우지 않고 남긴다 —
# "랩 밖에서 봐야 하는가" 가 참이 되는 순간 그대로 되살린다.
# 프로젝트 참조는 공개해도 되는 식별자다. **키·비밀번호는 .env 에만** 둔다.
SUPABASE_URL=https://<project-ref>.supabase.co

# 브라우저가 쓰는 공개 키(anon). RLS 가 켜져 있어야 안전하다.
SUPABASE_ANON_KEY=

# 서버(브리지)만 쓴다. RLS 를 우회하므로 **화면 번들에 절대 넣지 않는다.**
SUPABASE_SERVICE_ROLE_KEY=

# 마이그레이션용 직결. 비밀번호 포함이라 여기 원문을 적지 않는다.
SUPABASE_DB_URL=

# 터틀봇 브리지 주소 — 화면이 `?tb=` 없이도 붙는다 (2026-08-28).
# 비우면 `tb-host.json` 을 안 만들고, 화면은 「주소를 모른다」로 남는다(고장 아님).
# ⚠ 파이가 DHCP 라 주소가 바뀔 수 있다 — 바뀌면 여기를 고치고 config.mjs 를 다시 돌린다.
FR5_TB_HOST=192.168.30.15:5056
