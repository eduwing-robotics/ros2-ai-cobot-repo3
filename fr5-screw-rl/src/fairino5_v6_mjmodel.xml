              <body name="wrist3_link" pos="0 0 0.102" quat="0.707105 -0.707108 0 0">
                <inertial pos="0.00323665 1.31717e-05 0.122907" quat="0.708817 0.0129839 0.012974 0.705154" mass="1.03348" diaginertia="0.00372857 0.00358794 0.000618966"/>
                <joint name="j6" pos="0 0 0" axis="0 0 1" range="-3.0543 3.0543" actuatorfrcrange="-28 28" damping="0.5"/>
