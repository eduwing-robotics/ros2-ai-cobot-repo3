  <!-- Gripper (DH-Robotics PGEA-100-40) mesh is in mm. wrist3_link.STL itself
       spans local Z=53mm..99mm (the FAIRINO Coordinate6 tool flange is at the
       far end, ~99mm out from wrist3_link's own origin/Coordinate5), so the
       adapter plate mounts at Z=0.099m, not at the link origin. -->

  <!-- Real robot has a 1cm adapter plate between the tool flange and the
       gripper body (no CAD file, so a cylinder placeholder). Sized to the
       smaller connector-ring detail on wrist3_link's flange face (radius
       ~31-32mm), not the full 40mm housing radius. -->
  <link
    name="gripper_adapter_link">
    <visual>
      <origin
        xyz="0 0 0.005"
        rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.032" length="0.01" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0.005"
        rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.032" length="0.01" />
      </geometry>
    </collision>
  </link>
  <joint
    name="gripper_adapter_joint"
    type="fixed">
    <origin
      xyz="0 0 0.099"
      rpy="0 0 0" />
    <parent
      link="wrist3_link" />
    <child
      link="gripper_adapter_link" />
  </joint>

  <!-- rpy=+90 about X remaps the mesh's Y axis (138mm mount-to-fingertip span)
       onto link Z so the motor/mount body (raw y=-71.98mm) sits at the
       adapter plate and the jaws (raw y=+66.02mm) extend outward past it.
       Confirmed correct in RViz (mount flush against flange, jaws pointing
       away from robot). Z origin no longer includes the 0.099m flange
       offset, that now lives in gripper_adapter_joint above.

       scale x=-0.001 (not +0.001): the vendor STL's own X axis has the
       opposite handedness from the real robot — confirmed by comparing the
       cable connector stub against a real base_link/gripper_link TF axis
       display side-by-side with a matching-pose real-robot photo (connector
       was on +X on the real robot, -X in RViz). A pure rotation can't fix
       this (rotation matrices don't mirror), so the mesh itself is flipped
       on X here. The jaw-tip cluster is nearly symmetric (raw x=-28.4mm/
       +28.4mm) so finger_tip_right_link/finger_tip_left_link below did NOT
       need updating after this change — the two x values they use are
       essentially unchanged by the mirror, just swapped as to which raw
       cluster produces which. -->
  <link
    name="gripper_link">
    <visual>
      <origin
        xyz="0.0028 -0.325639 0.07198"
        rpy="1.5708 0 0" />
      <geometry>
        <mesh
          filename="/home/ej/rl_env/share/urdf/meshes/gripper/pgea_100_40.stl"
          scale="-0.001 0.001 0.001" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0.0028 -0.325639 0.07198"
        rpy="1.5708 0 0" />
      <geometry>
        <mesh
          filename="/home/ej/rl_env/share/urdf/meshes/gripper/pgea_100_40.stl"
          scale="-0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <joint
    name="gripper_joint"
    type="fixed">
    <origin
      xyz="0 0 0.01"
      rpy="0 0 0" />
    <parent
      link="gripper_adapter_link" />
    <child
      link="gripper_link" />
  </joint>

  <!-- Real robot's fingertips are 1.8cm longer than the stock PGEA jaws (no
       CAD file, so two small box placeholders). Re-measured directly from
       the STL vertices (stable across y=60..65.9mm cuts): the true jaw
       contact face is at raw x=-28.4mm/+28.4mm, raw y up to 66.02mm (flat,
       symmetric face). The earlier raw x=-31.6/+31.6mm estimate was the
       wider mounting flange, not the jaw face; the x=+-8.5mm center tabs
       found earlier were a different (non-jaw) feature. In gripper_link's
       local frame that is x=-0.026/+0.0311, z=0.138 (+0.1mm nudge added
       after visual check in RViz). -->

  <!-- Split into two independently-actuated links so the gripper can open/
       close in RViz/MoveIt2. finger_right_joint is the master (0 = the
       calibrated rest position above, matching the static mesh; positive =
       jaw slides inward/closes); finger_left_joint mimics it 1:1 so both
       sides move in symmetrically from their (asymmetric, measured) rest
       positions. Stroke limit (0.02m) and effort/velocity are placeholders
       — replace with the real PGEA-100-40 per-jaw stroke/force once known. -->
  <link
    name="finger_tip_right_link">
    <visual>
      <origin xyz="0 0 0.009" rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.018" />
      </geometry>
      <material name="">
        <color rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0.009"
        rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.018" />
      </geometry>
    </collision>
  </link>
  <joint
    name="finger_right_joint"
    type="prismatic">
    <origin
      xyz="0.0311 0 0.138"
      rpy="0 0 0" />
    <parent
      link="gripper_link" />
    <child
      link="finger_tip_right_link" />
    <axis
      xyz="-1 0 0" />
    <limit
      lower="0"
      upper="0.021"
      effort="20"
      velocity="0.05" />
    <dynamics
      damping="0"
      friction="0" />
  </joint>

  <link
    name="finger_tip_left_link">
    <visual>
      <origin
        xyz="0 0 0.009"
        rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.018" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.1 0.1 0.1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0.009"
        rpy="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.018" />
      </geometry>
    </collision>
  </link>
  <joint
    name="finger_left_joint"
    type="prismatic">
    <origin
      xyz="-0.026 0 0.138"
      rpy="0 0 0" />
    <parent
      link="gripper_link" />
    <child
      link="finger_tip_left_link" />
    <axis
      xyz="1 0 0" />
    <mimic
      joint="finger_right_joint"
      multiplier="1"
      offset="0" />
    <limit
      lower="0"
      upper="0.021"
      effort="20"
      velocity="0.05" />
    <dynamics
      damping="0"
      friction="0" />
  </joint>
